{
  "compilerOptions": {
    // relay는 심볼릭 링크라 peer 의존성을 스스로 못 찾는다. 호스트 것을 쓰게 한다.
    "baseUrl": ".",
    "paths": {
      "@evenrealities/even_hub_sdk": ["./node_modules/@evenrealities/even_hub_sdk"]
    },
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
